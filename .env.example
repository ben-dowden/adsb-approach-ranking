# Target aerodrome configuration (required)
AIRPORT_ICAO=EGLL
AIRPORT_LAT=51.4700
AIRPORT_LON=-0.4543

# Pipeline configuration (optional - defaults shown)
MAX_DISTANCE_NM=50
MAX_ALTITUDE_FT=15000
RING_DISTANCES=[20,15,10,5]
COHORT_WINDOW_SEC=600

# S3/R2 credentials for data ingestion (required for ingest)
# For ADS-B Exchange sample data, use the public credentials:
#   AWS_ACCESS_KEY_ID=7b8d31d9d2f2d73ffb2208614db599fa
#   AWS_SECRET_ACCESS_KEY=8bd955340e355418a5204e52a055005b6ca761f896abe0cccdd741638e790a76
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3-compatible endpoint (defaults to ADS-B Exchange R2 endpoint)
# S3_ENDPOINT=https://6ff2cd7dae70306649e2c1e1500e2e0a.r2.cloudflarestorage.com
# S3_BUCKET=adsbx-sample-data
# AWS_REGION=auto
