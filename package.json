{
  "name": "adsb-approach-ranking",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "pipeline:ingest": "pnpm --filter @adsb/pipeline ingest",
    "pipeline:normalize": "pnpm --filter @adsb/pipeline normalize",
    "pipeline:derive": "pnpm --filter @adsb/pipeline derive",
    "pipeline:score": "pnpm --filter @adsb/pipeline score",
    "pipeline:cruise": "pnpm --filter @adsb/pipeline cruise",
    "dashboard:dev": "pnpm --filter @adsb/dashboard dev",
    "dashboard:build": "pnpm --filter @adsb/dashboard build"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
