{
  "name": "@adsb/pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "ingest": "node --import tsx src/scripts/ingest.ts",
    "derive": "node --import tsx src/scripts/derive.ts",
    "score": "node --import tsx src/scripts/score.ts",
    "sequence": "node --import tsx src/scripts/sequence.ts",
    "normalize": "node --import tsx src/scripts/normalize.ts",
    "analyze": "node --import tsx src/scripts/analyze.ts",
    "cruise": "node --import tsx src/scripts/cruise.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@adsb/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.500.0",
    "@duckdb/node-api": "1.4.3-r.3",
    "dotenv": "^16.4.0",
    "glob": "^10.0.0",
    "minimist": "^1.2.8",
    "papaparse": "^5.4.0"
  },
  "devDependencies": {
    "@smithy/util-stream": "^4.0.0",
    "@types/minimist": "^1.2.5",
    "@types/papaparse": "^5.3.0",
    "aws-sdk-client-mock": "^4.0.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  }
}
